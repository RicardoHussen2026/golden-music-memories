# EXEMPLO: nenhuma conta ou publicação fica ativa com este arquivo.
# Copie para .env somente na configuração futura. Nunca comite .env.
GMM_PORT=8877
GMM_PUBLIC_ORIGIN=http://127.0.0.1:8877
GMM_DATA_DIR=.cache/publishing-private
# Definir uma senha exclusiva de pelo menos 16 caracteres para o serviço.
GMM_OPERATOR_PASSWORD=
# Chave aleatória de 32 bytes representada por 64 caracteres hexadecimais.
# Guardar separadamente do banco e do código; necessária para recuperar tokens.
GMM_ENCRYPTION_KEY=
GMM_ALLOW_NETWORK=false
GMM_ALLOW_PUBLISH=false
GMM_WORKER_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Opcional: solicita youtube.force-ssl para reagendar/remover agendamento.
YOUTUBE_MANAGE_SCHEDULES=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Declaração administrativa; preencher não comprova aprovação do TikTok.
TIKTOK_UPLOAD_APPROVED=false
