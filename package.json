{
  "name": "golden-music-memories",
  "version": "2.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node tests/catalog.cjs && node --test --test-concurrency=1 tests/server.test.mjs tests/operations.test.mjs tests/local-access.test.mjs tests/storage-backup.test.mjs tests/clip-library.test.mjs tests/cover-opening.test.mjs tests/video-assembly.test.mjs tests/collections.test.mjs tests/generated-trash.test.mjs tests/destinations.test.mjs && node tests/clip-catalog-ui.mjs",
    "service": "node --env-file-if-exists=.env server/runtime/http.mjs",
    "test:service": "node --test tests/server.test.mjs",
    "test:service:ui": "node tests/server-ui.cjs",
    "service:backup": "node --env-file-if-exists=.env server/runtime/backup.mjs",
    "service:setup": "node scripts/setup-service.mjs",
    "service:start": "powershell -NoProfile -File scripts/start-service.ps1",
    "service:stop": "powershell -NoProfile -File scripts/stop-service.ps1",
    "service:startup": "powershell -NoProfile -File scripts/install-startup.ps1",
    "test:operations": "node --test tests/operations.test.mjs",
    "test:operations:ui": "node tests/operations-ui.cjs",
    "test:local-access": "node --test tests/local-access.test.mjs && node tests/local-access-ui.cjs",
    "test:source-import": "node --test tests/auto-inspection.test.mjs tests/source-import.test.mjs && node tests/source-import-ui.cjs",
    "version:build": "node scripts/build-version.mjs",
    "predev": "npm run version:build",
    "preservice": "npm run version:build",
    "test:assembly": "node --test tests/cover-opening.test.mjs tests/video-assembly.test.mjs && node tests/video-assembly-ui.cjs",
    "test:version": "npm run version:build && node tests/version-ui.cjs",
    "test:editorial": "node --test tests/editorial.test.mjs && node tests/editorial-ui.cjs",
    "test:destinations": "node --test tests/destinations.test.mjs && node tests/editorial-ui.cjs",
    "test:collections": "node --test tests/collections.test.mjs && node tests/collections-ui.cjs",
    "rankings:collect": "node scripts/rankings-collect.mjs",
    "rankings:stage": "node scripts/rankings-plan.mjs",
    "test:rankings": "node --test tests/rankings.test.mjs && node tests/rankings-ui.cjs",
    "rankings:diagnostics": "node scripts/rankings-diagnostics.mjs",
    "test:search-empty": "node tests/search-empty-ui.cjs",
    "test:storage": "node --test tests/storage-backup.test.mjs && node tests/storage-ui.cjs",
    "service:restore": "node scripts/restore-service.mjs",
    "test:montage-flow": "node tests/montage-flow-ui.cjs",
    "test:repost": "node --test tests/repost-policy.test.mjs tests/repost-service.test.mjs tests/repost-file.test.mjs && node tests/repost-history-ui.cjs",
    "test:generated-trash": "node --test tests/generated-trash.test.mjs",
    "test:original-fit": "node --test tests/original-fit.test.mjs",
    "test:render-cpu": "node --test tests/render-cpu.test.mjs tests/render-cpu-integration.test.mjs",
    "test:catalog-filters": "node --test tests/catalog-filters.test.mjs && node tests/catalog-filters-ui.cjs",
    "test:static-motion": "node --test tests/static-motion.test.mjs && node tests/static-motion-ui.cjs",
    "test:historical-covers": "node --test tests/historical-covers.test.mjs && node tests/historical-covers-ui.cjs",
    "test:catalog-families": "node --test tests/catalog-families.test.mjs tests/catalog-family-policy.test.mjs && node tests/catalog-families-ui.cjs",
    "test:intros": "node --test tests/intros.test.mjs && node tests/intros-ui.mjs",
    "test:clips": "node --test tests/clip-library.test.mjs && node tests/clip-catalog-ui.mjs",
    "test:legacy-catalog": "node tests/search.cjs && node tests/catalog.cjs && node tests/acceptance.cjs && node tests/repertorio.cjs && node tests/templates.cjs && node tests/publishing.cjs && node tests/ux.cjs && node tests/publication-ui.cjs && node tests/post-audit.cjs && node --test tests/server.test.mjs && node tests/server-ui.cjs && node --test tests/operations.test.mjs && node tests/operations-ui.cjs",
    "test:clip-research": "node --test tests/clip-research.test.mjs",
    "test:quality": "node --test tests/quality-workflow.test.mjs",
    "test:finance": "node --test tests/finance.test.mjs",
    "test:downloader": "node --test tests/media-downloader.test.mjs tests/downloader-workspace.test.mjs tests/downloader-playlists.test.mjs",
    "test:artworks": "node --test tests/artwork-library.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "jszip": "3.10.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
